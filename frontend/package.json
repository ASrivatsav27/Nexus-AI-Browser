{
  "name": "@nexus/frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 48000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 48000",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"next dev --hostname 127.0.0.1 --port 48000\" \"wait-on http://127.0.0.1:48000 && electron electron/main.cjs\"",
    "electron:fresh": "concurrently -k \"next dev --hostname 127.0.0.1 --port 48000\" \"wait-on http://127.0.0.1:48000 && electron electron/main.cjs --fresh\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.4"
  },
  "trustedDependencies": [
    "electron"
  ],
  "allowScripts": {
    "electron": true
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
